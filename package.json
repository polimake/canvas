{
  "name": "@pm/canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "src/core/excal.ts",
    "./dist/index.js",
    "./dist/ui.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    },
    "./styles.css": "./dist/canvas2.css",
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui.js"
    },
    "./parsers": {
      "types": "./dist/parsers/index.d.ts",
      "import": "./dist/parsers.js"
    },
    "./converters": {
      "types": "./dist/converters/index.d.ts",
      "import": "./dist/converters.js"
    },
    "./indexers": {
      "types": "./dist/indexers/index.d.ts",
      "import": "./dist/indexers.js"
    }
  },
  "scripts": {
    "dev:workspaces": "vite examples/workspaces --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "ag-psd": "^31.0.2",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "docs"
  ]
}
